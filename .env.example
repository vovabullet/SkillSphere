# Flask application
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: AI & OAuth integrations
GIGACHAT_KEY=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
SUPERJOB_CLIENT_ID=
SUPERJOB_CLIENT_SECRET=
SUPERJOB_REDIRECT_URI=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# ELK / application logging
APP_LOG_LEVEL=INFO
APP_LOG_PATH=/var/log/skillsphere/app.log
ELK_INDEX_PREFIX=skillsphere
